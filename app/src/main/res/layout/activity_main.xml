<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F0F4FF">
<LinearLayout android:id="@+id/mainContent" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" android:visibility="invisible">
<!--  Header  -->
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="16dp">
<TextView android:text="💳 BankTracker" android:textSize="22sp" android:textStyle="bold" android:textColor="#1E293B" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"/>
<TextView android:text="🔐" android:textSize="20sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
</LinearLayout>
<!--  Card tháng này  -->
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="#FFFFFF" android:padding="16dp" android:layout_marginBottom="10dp">
<TextView android:text="THÁNG NÀY" android:textSize="11sp" android:textColor="#64748B" android:letterSpacing="0.08" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="10dp"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
<LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
<TextView android:text="Chi tiêu" android:textSize="12sp" android:textColor="#64748B" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
<TextView android:id="@+id/tvExpenseMonth" android:text="0 đ" android:textSize="20sp" android:textStyle="bold" android:textColor="#DC2626" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
</LinearLayout>
<LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
<TextView android:text="Thu nhập" android:textSize="12sp" android:textColor="#64748B" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
<TextView android:id="@+id/tvIncomeMonth" android:text="0 đ" android:textSize="20sp" android:textStyle="bold" android:textColor="#16A34A" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
</LinearLayout>
</LinearLayout>
</LinearLayout>
<!--  Cards tuần & hôm nay  -->
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="10dp">
<LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:background="#FFFFFF" android:padding="14dp" android:layout_marginEnd="5dp">
<TextView android:text="TUẦN NÀY" android:textSize="10sp" android:textColor="#64748B" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
<TextView android:id="@+id/tvExpenseWeek" android:text="0 đ" android:textSize="15sp" android:textStyle="bold" android:textColor="#DC2626" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
</LinearLayout>
<LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:background="#FFFFFF" android:padding="14dp" android:layout_marginStart="5dp">
<TextView android:text="HÔM NAY" android:textSize="10sp" android:textColor="#64748B" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
<TextView android:id="@+id/tvExpenseDay" android:text="0 đ" android:textSize="15sp" android:textStyle="bold" android:textColor="#DC2626" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
</LinearLayout>
</LinearLayout>
<!--  Số giao dịch  -->
<TextView android:id="@+id/tvTxCount" android:text="0 giao dịch tháng này" android:textSize="12sp" android:textColor="#64748B" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="14dp"/>
<!--  Buttons  -->
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="16dp">
<Button android:id="@+id/btnHistory" android:text="📋 Lịch sử" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginEnd="5dp" android:backgroundTint="#2563EB" android:textColor="#FFFFFF"/>
<Button android:id="@+id/btnStats" android:text="📊 Thống kê" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginStart="5dp" android:backgroundTint="#7C3AED" android:textColor="#FFFFFF"/>
</LinearLayout>
<!--  Giao dịch gần nhất  -->
<TextView android:text="Giao dịch gần nhất" android:textSize="15sp" android:textStyle="bold" android:textColor="#1E293B" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="8dp"/>
<LinearLayout android:id="@+id/recentList" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="#FFFFFF"/>
</LinearLayout>
</ScrollView>
