<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="12dp"
    android:background="?android:selectableItemBackground">

    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginBottom="2dp">
            <TextView android:id="@+id/tvItemBank"
                android:textSize="13sp" android:textStyle="bold" android:textColor="#1E293B"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <TextView android:text=" · " android:textSize="13sp" android:textColor="#94A3B8"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <TextView android:id="@+id/tvItemCat"
                android:textSize="12sp" android:textColor="#2563EB"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </LinearLayout>

        <TextView android:id="@+id/tvItemDesc"
            android:textSize="12sp" android:textColor="#475569" android:maxLines="1"
            android:ellipsize="end"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>

        <TextView android:id="@+id/tvItemDate"
            android:textSize="11sp" android:textColor="#94A3B8" android:layout_marginTop="2dp"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    </LinearLayout>

    <TextView android:id="@+id/tvItemAmount"
        android:textSize="14sp" android:textStyle="bold"
        android:layout_gravity="center_vertical" android:layout_marginStart="8dp"
        android:layout_width="wrap_content" android:layout_height="wrap_content"/>
</LinearLayout>
